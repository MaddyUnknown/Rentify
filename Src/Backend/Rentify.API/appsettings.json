{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "StreamBufferSize": 81920
  },
  "Auth": {
    "Issuer": "RentifyAuth",
    "Audience": "RentifyAPI",
    "AccessTokenDurationInMinutes": 15,
    "JwtAccessTokenDurationInMinutes":  7
  }
}
